# Copy this file to .env and fill in your values. Never commit .env.

# --- Stripe (required for checkout) ---------------------------------------
# Dashboard → Developers → API keys. Use sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=sk_test_replace_me
# Optional: Dashboard → Developers → Webhooks → add endpoint https://YOURDOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Set to true after enabling Stripe Tax in your dashboard to collect sales tax automatically.
STRIPE_AUTOMATIC_TAX=false

# Public URL of the site (used for Stripe success/cancel redirects). Leave blank to auto-detect.
SITE_URL=

# --- Contact form email (optional) -----------------------------------------
# Without SMTP settings, the contact form opens the visitor's email app instead.
# Outlook.com example: smtp-mail.outlook.com, port 587 (may require an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=vantelia.home@outlook.com

PORT=3000
